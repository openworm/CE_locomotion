    # GraphViz compliant export for:Worm2DNet (Type: network)

digraph Worm2D {
fontsize=10;
overlap=false;


subgraph cluster_network {
    style=filled;
    color="#D6eeEA";
    node [style=filled,color=white];
    label = "Network to be simulated";

    node [shape=rectangle]; Worm2DNet;
    #    Population PopAS contains components of: Component(id=AS type=cellW2D) 
    node [shape=ellipse,color="#cc194c",fontcolor="black"]; PopAS;    
    Worm2DNet -> PopAS [len=1.00, arrowhead=diamond]

    #    Population PopDA contains components of: Component(id=DA type=cellW2D) 
    node [shape=ellipse,color="#d1b26d",fontcolor="black"]; PopDA;    
    Worm2DNet -> PopDA [len=1.00, arrowhead=diamond]

    #    Population PopDB contains components of: Component(id=DB type=cellW2D) 
    node [shape=ellipse,color="#6dafaa",fontcolor="black"]; PopDB;    
    Worm2DNet -> PopDB [len=1.00, arrowhead=diamond]

    #    Population PopDD contains components of: Component(id=DD type=cellW2D) 
    node [shape=ellipse,color="#3d519e",fontcolor="black"]; PopDD;    
    Worm2DNet -> PopDD [len=1.00, arrowhead=diamond]

    #    Population PopVA contains components of: Component(id=VA type=cellW2D) 
    node [shape=ellipse,color="#84542b",fontcolor="black"]; PopVA;    
    Worm2DNet -> PopVA [len=1.00, arrowhead=diamond]

    #    Population PopVB contains components of: Component(id=VB type=cellW2D) 
    node [shape=ellipse,color="#2b665e",fontcolor="white"]; PopVB;    
    Worm2DNet -> PopVB [len=1.00, arrowhead=diamond]

    #    Population PopVD contains components of: Component(id=VD type=cellW2D) 
    node [shape=ellipse,color="#a5c6e5",fontcolor="black"]; PopVD;    
    Worm2DNet -> PopVD [len=1.00, arrowhead=diamond]

    #    Population PopMD1 contains components of: Component(id=MD1 type=muscX) 
    node [shape=ellipse,color="#33cc19",fontcolor="black"]; PopMD1;    
    Worm2DNet -> PopMD1 [len=1.00, arrowhead=diamond]

    #    Population PopMV1 contains components of: Component(id=MV1 type=muscX) 
    node [shape=ellipse,color="#e56619",fontcolor="black"]; PopMV1;    
    Worm2DNet -> PopMV1 [len=1.00, arrowhead=diamond]

}

