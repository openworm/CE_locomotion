    muscX -> baseCellMembPot [len=1.00, arrowhead=onormal]
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseSpikingCell</td></tr></table>>]; baseSpikingCell;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseCell</td></tr></table>>]; baseCell;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseStandalone</td></tr></table>>]; baseStandalone;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>muscX</td></tr><tr><td><font color="#669999">Params: tau (time), state0 </font></td></tr><tr><td><font color="#662211">Consts: COND_SCALE = 1.0E-9 S, MVOLT = 0.001 V, PAMP = 1.0E-12 A </font></td></tr><tr><td><font color="#FF9966">State vars: v (voltage), spiking </font></td></tr><tr><td><font color="#99CC00">iSyn = SUM OF: synapses[*]/i</font></td></tr><tr><td><font color="#99CC00">state = v/MVOLT</font></td></tr><tr><td><font color="#99CC00">iMemb = ((0-state)*PAMP + iSyn)</font></td></tr><tr><td><font color="#666633">v' = iMemb / C</font></td></tr><tr><td><font color="#996633">IF v .gt. 0 AND spiking .lt. 0.5 THEN </font></td></tr><tr><td><font color="#996633">(spiking = 1)  <br/>AND (EVENT: spike)</font></td></tr><tr><td><font color="#996633">IF v .lt. 0 THEN </font></td></tr><tr><td><font color="#996633">(spiking = 0)</font></td></tr><tr><td><font color="#666666">Exposures: spiking, state, iSyn (current), <br/>iMemb (current), v (voltage) </font></td></tr></table>>]; muscX;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseCellMembPot</td></tr><tr><td><font color="#666666">Exposures: v (voltage) </font></td></tr></table>>]; baseCellMembPot;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseSpikingCell</td></tr></table>>]; baseSpikingCell;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseCell</td></tr></table>>]; baseCell;
    node [shape=box label=<<table border="0" cellborder="0"><tr><td>baseStandalone</td></tr></table>>]; baseStandalone;
}

