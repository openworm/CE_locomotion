# Framework for running automated tests on Open Source Brain
# See https://github.com/OpenSourceBrain/osb-model-validation for more details
 
target: testW2DSR18.py
engine: Brian2  # This installs Brian2, but all we really need is a Python environment to run the script in
mep: .test.2018gen.mep
experiments:
  Test:
    observables:
      spike times:
        file: 
          path: testruns/exW2DSR18/act.dat
          columns: [0, 1]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 0.8
        tolerance: 0
  Test2:
    observables:
      spike times:
        file: 
          path: testruns/exW2DSR18_nml/act.dat
          columns: [0, 1]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 0.8
        tolerance: 0.031992001999500155
  Test3:
    observables:
      spike times:
        file: 
          path: testruns/exW2DSR18_nml_musc/act.dat
          columns: [0, 1]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 0.8
        tolerance: 0.19047619047619052