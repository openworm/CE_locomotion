# Framework for running automated tests on Open Source Brain
# See https://github.com/OpenSourceBrain/osb-model-validation for more details
 
target: run_izq_sims_W2D21.py
engine: Brian2  # This installs Brian2, but all we really need is a Python environment to run the script in
mep: .test.izq_sim_W2D21.mep
experiments:
    Test2:
        observables:
            spike times:
                file: 
                    path: experiments/izq_runs_nets_nml_W2D21/103/act.dat
                    columns: [0, 3]
                    scaling: [1, 1]
                spike detection: 
                    method: threshold
                    threshold: 0.5
                tolerance: 0.00
    Test3:
        observables:
            spike times:
                file: 
                    path: experiments/izq_runs_nets_nml_musc_W2D21/103/act.dat
                    columns: [0, 3]
                    scaling: [1, 1]
                spike detection: 
                    method: threshold
                    threshold: 0.5
                tolerance: 0.00
    Test4:
        observables:
            spike times:
                file: 
                    path: experiments/izq_runs_nets_W2D21/103/act.dat
                    columns: [0, 3]
                    scaling: [1, 1]
                spike detection: 
                    method: threshold
                    threshold: 0.5
                tolerance: 0.0